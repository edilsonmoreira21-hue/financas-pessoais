rules_version = '2';

// Finanças Pessoais — cada conta só enxerga o próprio ramo da árvore.
// Cole no console do Firebase: Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // tudo do app vive em users/{uid}/...
    match /users/{uid}/{documento=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // qualquer outro caminho fica fechado
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
